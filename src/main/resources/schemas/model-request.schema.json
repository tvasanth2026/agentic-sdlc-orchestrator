{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["agentRole", "schemaName", "instructions", "context", "maxOutputCharacters"],
  "properties": {
    "agentRole": {"type": "string", "minLength": 1},
    "schemaName": {"enum": ["specialist_output", "file_operation_proposal"]},
    "instructions": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "maxOutputCharacters": {"type": "integer", "minimum": 512, "maximum": 100000}
  }
}
