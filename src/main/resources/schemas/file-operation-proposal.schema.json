{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file-operation-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "operationType", "content", "expectedSha256", "reason", "requirementId", "acceptanceCriterionIds", "taskId", "inputArtifactHashes"],
        "properties": {
          "relativePath": {"type": "string", "minLength": 1},
          "operationType": {"enum": ["CREATE", "UPDATE", "DELETE"]},
          "content": {"type": ["string", "null"]},
          "expectedSha256": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1},
          "requirementId": {"type": "string", "minLength": 1},
          "acceptanceCriterionIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "taskId": {"type": "string", "minLength": 1},
          "inputArtifactHashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
